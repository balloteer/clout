# Server-only local defaults. Production overrides are listed below.
CLOUT_MODE=demo
PORT=8787
HOST=127.0.0.1
CLOUT_ORIGIN=http://localhost:8787
CLOUT_ALLOWED_ORIGINS=http://localhost:8787,http://localhost:8081

# Required connected deployment values. Dockerfile.vercel sets NODE_ENV, HOST,
# and one trusted Vercel proxy hop. Vercel injects PORT; do not set it manually.
# CLOUT_MODE=connected
# Vercel derives the stable HTTPS origin from VERCEL_PROJECT_PRODUCTION_URL.
# CLOUT_ORIGIN=https://optional-custom-production-domain.example
# CLOUT_ALLOWED_ORIGINS=https://optional-custom-production-domain.example
# Same 64-hex-character secret stored in the Cloudflare recovery Worker.
# MAINTENANCE_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
# Serve Android Digital Asset Links from the API origin used as the wallet identity URI.
# ANDROID_APP_PACKAGE=app.clout.mobile
# ANDROID_APP_SHA256_CERT_FINGERPRINT=SHA256_FINGERPRINT_FROM_APKSIGNER

# Connected mode uses the Supabase server-side session/shared pooler. Store the
# full URL as a sealed platform secret. Never expose it through EXPO_PUBLIC_*.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PERCENT_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# SOLANA_DEVNET_RPC_URL=https://your-devnet-rpc.example
# Read-only mainnet identity lookup only; transactions never use this connection.
# SOLANA_MAINNET_IDENTITY_RPC_URL=https://api.mainnet-beta.solana.com
# SKR_DEVNET_MINT=DEVNET_MOCK_SKR_MINT (never mainnet SKR)
SKR_DECIMALS=6
# METEORA_DBC_CONFIG=DEVNET_DBC_CONFIG
# Hosted uploads use Supabase Storage: private staging, verified public MP4 playback.
# Apply 20261014034917_supabase_video_storage.sql first. 50 MiB / 60 seconds maximum.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=SERVER_ONLY_SUPABASE_SECRET_KEY
# Legacy service_role JWT can instead be set in SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_UPLOAD_BUCKET=clout-upload-staging
# SUPABASE_VIDEO_BUCKET=clout-videos
# Optional only for historical Stream callbacks; new uploads never use Stream.
# CLOUDFLARE_STREAM_WEBHOOK_SECRET=LEGACY_WEBHOOK_SECRET
# Local physical-device demos only. Requires a loopback CLOUT_ORIGIN and is refused in production.
LOCAL_UPLOADS_ENABLED=false

# Mainnet SGT rewards remain unavailable. Optional .skr reads do not authorize transactions.
REWARDS_ENABLED=false

# Owned X video imports. Requires both migrations and a confidential OAuth2 app.
LINKED_ACCOUNTS_ENABLED=false
# X_CLIENT_ID=X_OAUTH_CLIENT_ID
# X_CLIENT_SECRET=X_OAUTH_CLIENT_SECRET
# LINKED_ACCOUNTS_ENCRYPTION_KEY=BASE64_OF_EXACTLY_32_RANDOM_BYTES
# Register ${CLOUT_ORIGIN}/v1/linked-accounts/x/callback in the X developer console.
# Read scopes only: tweet.read users.read offline.access. Fomo is unavailable.

# One 1,000 mock SKR allocation per wallet per UTC day; resets at 00:00 UTC.
FAUCET_ENABLED=false
# FAUCET_CAMPAIGN_ID=faucet_daily_20261013
# FAUCET_AMOUNT_UNITS=1000000000
# FAUCET_MAX_DAILY_CLAIMS=10000 (global daily reservation circuit breaker)
# FAUCET_MAX_SUPPLY_UNITS=1000000000000000 (absolute ceiling: 1 billion six-decimal mock SKR)
# FAUCET_MINT_AUTHORITY_SECRET_BASE64=BASE64_OF_64_BYTE_DEVNET_AUTHORITY_KEY
# Requires verified devnet mint authority, standard SPL, no freeze authority, and SOL fees/rent.
# Inject secrets through your secret manager; never Expo variables, commits or logs.
