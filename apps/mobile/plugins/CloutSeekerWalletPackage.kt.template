package __CLOUT_PACKAGE__

import android.content.Intent
import android.net.Uri
import com.facebook.react.BaseReactPackage
import com.facebook.react.bridge.NativeModule
import com.facebook.react.bridge.Promise
import com.facebook.react.bridge.ReactApplicationContext
import com.facebook.react.bridge.ReactContextBaseJavaModule
import com.facebook.react.bridge.ReactMethod
import com.facebook.react.module.model.ReactModuleInfo
import com.facebook.react.module.model.ReactModuleInfoProvider

internal class CloutSeekerWalletModule(context: ReactApplicationContext) : ReactContextBaseJavaModule(context) {
  override fun getName() = "CloutSeekerWallet"

  override fun getConstants(): Map<String, Any> = mapOf("routingPolicy" to "seeker-certified-v1")

  @ReactMethod
  fun assertAvailable(promise: Promise) {
    try {
      // Resolve only: this never launches an activity, signs, or authorizes a wallet.
      SeekerWalletRouter.route(
        reactApplicationContext,
        Intent(Intent.ACTION_VIEW, Uri.parse("solana-wallet:/v1/associate/local"))
          .addCategory(Intent.CATEGORY_BROWSABLE),
      )
      promise.resolve(null)
    } catch (_: Exception) {
      promise.reject("CLOUT_SEEKER_WALLET_REQUIRED", "Install or update the official Seed Vault Wallet on your Seeker. No other wallet was opened.")
    }
  }
}

class CloutSeekerWalletPackage : BaseReactPackage() {
  override fun getModule(name: String, reactContext: ReactApplicationContext): NativeModule? =
    if (name == "CloutSeekerWallet") CloutSeekerWalletModule(reactContext) else null

  override fun getReactModuleInfoProvider() = ReactModuleInfoProvider {
    mapOf("CloutSeekerWallet" to ReactModuleInfo(
      "CloutSeekerWallet", CloutSeekerWalletModule::class.java.name, false, false, false, false,
    ))
  }
}
